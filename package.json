    "@vue-vine/eslint-config": "^1.1.12",
    "eslint": "^9.39.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "unocss": "^66.5.10",
    "vite": "npm:rolldown-vite@latest",
